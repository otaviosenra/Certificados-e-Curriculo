{
  // Example VS Code workspace. Copy this file per workspace (e.g. projectX.code-workspace,
  // projectY.code-workspace) and give each its own AI_WS_CODE.
  // The same code folder can be referenced from several workspaces; the workspace code
  // is what tells the Developer which workspace a branch came from.
  "folders": [
    { "path": "." }
    // add more folders here, e.g. { "path": "../proyectoB" }
  ],
  "settings": {
    // Workspace code injected into the terminal. The Developer reads $AI_WS_CODE
    // when creating the feature branch (see .ai-docs/VERSIONING.md).
    // Use the key matching your OS: .linux / .osx / .windows
    "terminal.integrated.env.linux":   { "AI_WS_CODE": "X" },
    "terminal.integrated.env.osx":     { "AI_WS_CODE": "X" },
    "terminal.integrated.env.windows": { "AI_WS_CODE": "X" }
  }
}
